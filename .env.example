# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Supabase (free tier): https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Models (Gemini free tier)
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Upload & request limits
MAX_UPLOAD_MB=8
MAX_QUESTION_LENGTH=2000
MAX_DOCUMENT_IDS=10

# Agent guardrails
MAX_AGENT_ITERATIONS=5
MAX_CRITIQUE_RETRIES=2
MIN_SIMILARITY_SCORE=0.35
MAX_ANSWER_LENGTH=4000
MAX_PAGES_PER_DOC=100
MAX_CHUNKS_PER_DOC=200
LLM_CHAT_TIMEOUT_MS=120000
EMBED_TIMEOUT_MS=60000

# Rate limits (per IP, per minute)
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10

# Frontend (Vite) — set at build time on Vercel
VITE_API_URL=http://localhost:8787

# Production CORS — comma-separated allowed origins (set on Render)
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173
